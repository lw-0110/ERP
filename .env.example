NODE_ENV=development
WEB_PORT=5173
API_PORT=3000
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform?schema=public
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
BETTER_AUTH_SECRET=replace-with-a-32-character-development-secret
BETTER_AUTH_URL=http://localhost:3000
WEB_URL=http://localhost:5173
DEFAULT_ORGANIZATION_SLUG=development
DEVELOPMENT_ORGANIZATION_NAME=Development Organization
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_MUTATION_MAX=120
RATE_LIMIT_INVITATION_MAX=30
STAFF_INVITATION_TTL_HOURS=72
APP_VERSION=1.0.0
SWAGGER_ENABLED=true
VITE_API_URL=http://localhost:3000
DEMO_SEED_ENABLED=false
DEMO_ORGANIZATION_SLUG=demo
DEMO_ORGANIZATION_NAME=Demo Organization
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ORGANIZATION_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_CONFIRMED=no
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=
DEMO_CUSTOMER_PASSWORD=
DEMO_RESET_CONFIRMED=no
# PUBLIC_API_URL is a production web-image build argument.
PUBLIC_API_URL=http://localhost:3000
# Production operators must set all limits and invitation expiry explicitly and use HTTPS URLs.
# Demo and bootstrap passwords are secrets supplied only at command execution time; never commit them.
